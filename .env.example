# Copy this file to .env in the directory where you run jev-sim.
# Or use Connect Jev in the dashboard to create .env automatically.
# Get a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=your-typesafe-api-key
TYPESAFE_MODEL=jev-latest
# Maximum real inference calls per run, search, or counterfactual operation.
JEV_SIM_MAX_REQUESTS=1000
